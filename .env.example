# Copy to .env (gitignored, `chmod 600 .env`) in the repo root, on your laptop and on the
# server alike. Locally: uv run --env-file .env job-scout ...; on the server, compose reads
# it (deploy/compose.yaml env_file). Never commit the real file. Another instance has its
# own copy in instances/<name>/.env (see "Docker compose only" at the end).
# Every environment variable job-scout reads (tests/test_deploy.py checks this list).
# Precedence: CLI flag > env var > config/settings.yaml > built-in default.
# Any setting can be overridden as JOB_SCOUT_<SECTION>__<KEY>, nested with "__", e.g.
# JOB_SCOUT_SCORING__MODES__DAILY__CLI__MAX_CALLS=3

# --- Paths. Default: the repo's gitignored data/ (relative to the working directory) ------
# JOB_SCOUT_PATHS__DATABASE=data/job-scout.db
# JOB_SCOUT_PATHS__REPORTS=data/reports
# JOB_SCOUT_PATHS__EXPORTS=data/exports
# JOB_SCOUT_SCORING__CLI__WORKDIR=data/claude-cwd
# Or a full SQLAlchemy URL (wins over PATHS__DATABASE)
# JOB_SCOUT_DATABASE_URL=sqlite:///data/job-scout.db
# Directory with the four config files (default: ./config)
# JOB_SCOUT_CONFIG_DIR=./config

# --- Scoring ---------------------------------------------------------------------------
# JOB_SCOUT_BACKEND=cli                  # cli (Pro subscription) or api (billed per token)
# JOB_SCOUT_MODEL=claude-haiku-5-5
# JOB_SCOUT_SCORING__EFFORT=low          # low | medium | high | xhigh | max
# JOB_SCOUT_SCORING__CLI__TOKEN_CREATED=2026-10-14  # day you ran `claude setup-token`;
#                                        # `status` and the digest warn 30 days before expiry
# JOB_SCOUT_LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR

# --- Digest email ----------------------------------------------------------------------
# JOB_SCOUT_DIGEST__EMAIL__TO_ADDRESS=you@example.com   # recipient(s), comma-separated

# --- Feedback page ---------------------------------------------------------------------
# Where the digest's 👍/👎 links point, as seen from where you read the digest
# (on the server e.g. http://jobscout.lan:8765). `job-scout feedback serve` listens on host:port
# JOB_SCOUT_FEEDBACK__BASE_URL=http://127.0.0.1:8765
# JOB_SCOUT_FEEDBACK__HOST=127.0.0.1     # the compose service sets 0.0.0.0

# --- Secrets. Never commit real values. --------------------------------------------------
# CLAUDE_CODE_OAUTH_TOKEN=     # from `claude setup-token` (valid one year); cli backend only
# ANTHROPIC_API_KEY=           # api backend only; never passed to the claude CLI
# JOB_SCOUT_SMTP_TOKEN=        # Proton SMTP token for digest.email.from_address (send-only)
# JOB_SCOUT_FEEDBACK_SECRET=   # signs the digest's 👍/👎 links: `openssl rand -hex 32`
# FINDWORK_API_KEY=            # free account at findwork.dev; the source is skipped while unset

# --- Docker compose only -----------------------------------------------------------------
# For your instance, export them in the shell before `docker compose` if the defaults don't
# suit you (compose doesn't read the repo's .env for them; the defaults suit a user with
# UID/GID 1000, see `id`).
# JOB_SCOUT_UID=1000           # user the image runs as (build time)
# JOB_SCOUT_GID=1000
# JOB_SCOUT_FEEDBACK_PORT=8765 # host port the feedback page is published on
# Another instance's instances/<name>/.env sets these three, and compose reads them from it
# with `docker compose --env-file ../instances/<name>/.env ...` (run from deploy/). Never
# export them in the shell: shell values win over the instance's file.
# COMPOSE_PROJECT_NAME=job-scout-<name>
# JOB_SCOUT_INSTANCE_DIR=../instances/<name>   # relative to deploy/; default: .. (the repo)
# JOB_SCOUT_FEEDBACK_PORT=8766                 # a host port no other instance uses
