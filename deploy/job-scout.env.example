# Copy to /etc/job-scout/job-scout.env on the server: owner root, mode 600.
# Read by docker compose (env_file). Never commit the real file.

# cli backend: from `claude setup-token` (valid one year; also set
# scoring.cli.token_created in config/settings.yaml so the digest warns before it expires)
CLAUDE_CODE_OAUTH_TOKEN=

# api backend (backlog with --backend api); never reaches the claude CLI subprocess
ANTHROPIC_API_KEY=

# Digest email: Proton SMTP token for digest.email.from_address, and the recipient(s)
JOB_SCOUT_SMTP_TOKEN=
JOB_SCOUT_DIGEST__EMAIL__TO_ADDRESS=

# Feedback page (thumbs up/down in the digest): the link-signing secret, from
# `openssl rand -hex 32`, and the page's address as seen from where you read the digest
JOB_SCOUT_FEEDBACK_SECRET=
JOB_SCOUT_FEEDBACK__BASE_URL=http://jobscout.lan:8765

# Optional: findwork.dev source (skipped while unset)
# FINDWORK_API_KEY=
