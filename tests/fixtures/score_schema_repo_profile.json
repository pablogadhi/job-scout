{
 "$defs": {
  "RequirementsItem": {
   "additionalProperties": false,
   "properties": {
    "skill": {
     "type": "string"
    },
    "importance": {
     "enum": [
      "required",
      "nice-to-have"
     ],
     "type": "string"
    },
    "primary": {
     "type": "boolean"
    },
    "match": {
     "enum": [
      "core",
      "solid",
      "equivalent",
      "partial",
      "missing"
     ],
     "type": "string"
    },
    "evidence": {
     "type": "string"
    }
   },
   "required": [
    "skill",
    "importance",
    "primary",
    "match",
    "evidence"
   ],
   "type": "object"
  },
  "ScoreResult": {
   "additionalProperties": false,
   "properties": {
    "job_id": {
     "type": "integer"
    },
    "remote": {
     "enum": [
      "yes",
      "no",
      "unclear"
     ],
     "type": "string"
    },
    "location_eligibility": {
     "enum": [
      "pass",
      "fail",
      "unclear"
     ],
     "type": "string"
    },
    "location_notes": {
     "type": "string"
    },
    "salary": {
     "enum": [
      "meets",
      "below",
      "unlisted"
     ],
     "type": "string"
    },
    "salary_usd_range": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "salary_notes": {
     "type": "string"
    },
    "language": {
     "enum": [
      "english-or-spanish",
      "other"
     ],
     "type": "string"
    },
    "role_category": {
     "enum": [
      "backend",
      "full-stack",
      "frontend",
      "infrastructure",
      "devops",
      "platform",
      "sre",
      "tech-lead",
      "data-engineering",
      "iot",
      "embedded",
      "engineering-manager",
      "mobile",
      "other"
     ],
     "type": "string"
    },
    "seniority": {
     "type": "string"
    },
    "seniority_level": {
     "enum": [
      "intern",
      "junior",
      "mid",
      "senior",
      "lead",
      "staff",
      "principal",
      "unstated"
     ],
     "type": "string"
    },
    "requirements": {
     "items": {
      "$ref": "#/$defs/RequirementsItem"
     },
     "type": "array"
    },
    "signals": {
     "items": {
      "$ref": "#/$defs/SignalsItem"
     },
     "type": "array"
    },
    "employment_type": {
     "enum": [
      "employee",
      "eor",
      "contractor",
      "unknown"
     ],
     "type": "string"
    },
    "red_flags": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "summary": {
     "type": "string"
    }
   },
   "required": [
    "job_id",
    "remote",
    "location_eligibility",
    "location_notes",
    "salary",
    "salary_usd_range",
    "salary_notes",
    "language",
    "role_category",
    "seniority",
    "seniority_level",
    "requirements",
    "signals",
    "employment_type",
    "red_flags",
    "summary"
   ],
   "type": "object"
  },
  "SignalsItem": {
   "additionalProperties": false,
   "properties": {
    "signal": {
     "enum": [
      "four_day_week",
      "async_first",
      "flexible_hours",
      "pto_minimum",
      "sabbatical",
      "after_hours_limits",
      "sustainable_pace",
      "remote_handbook",
      "domain_fintech",
      "domain_healthcare",
      "domain_crm",
      "domain_hcm",
      "domain_b2b_platforms",
      "gaming_role_fit",
      "fast_paced",
      "hustle",
      "long_hours",
      "many_hats_early_stage",
      "high_intensity",
      "we_are_a_family",
      "growth_at_all_costs",
      "pays_local_rates",
      "frequent_travel"
     ],
     "type": "string"
    },
    "evidence": {
     "type": "string"
    }
   },
   "required": [
    "signal",
    "evidence"
   ],
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "results": {
   "items": {
    "$ref": "#/$defs/ScoreResult"
   },
   "type": "array"
  }
 },
 "required": [
  "results"
 ],
 "type": "object"
}
